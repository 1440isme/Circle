generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum GlobalRole {
  USER
  ADMIN
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum ChannelType {
  TEXT
  VOICE
}

enum MessageType {
  TEXT
  FILE
  VOICE
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  ACTIVE
  ENDED
}

enum MomentMediaType {
  IMAGE
  VIDEO
}

// =============================================================================
// 1. ACCOUNT & SOCIAL CONNECTIONS
// =============================================================================

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  isActivated  Boolean     @default(false)
  globalRole   GlobalRole  @default(USER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  profile              UserProfile?
  refreshTokens        RefreshToken[]
  sentFriendships      Friendship[]       @relation("FriendshipSender")
  receivedFriendships  Friendship[]       @relation("FriendshipReceiver")
  notifications        Notification[]
  memberships          CircleMember[]
  circleJoinRequests   CircleJoinRequest[]
  moments              Moment[]
  momentReactions      MomentReaction[]

  @@index([email])
}

model UserProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  displayName String
  avatarUrl   String?
  bio         String?
  dateOfBirth DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sender   User @relation("FriendshipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  isRead    Boolean  @default(false)
  type      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// =============================================================================
// 2. CIRCLE CORE DOMAIN
// =============================================================================

model Circle {
  id          String    @id @default(cuid())
  name        String
  handle      String    @unique
  avatarUrl   String?
  inviteCode  String    @unique
  isPrivate   Boolean   @default(false)
  maxMembers  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  members         CircleMember[]
  channels        Channel[]
  invites         CircleInvite[]
  joinRequests    CircleJoinRequest[]
  planningSheets  PlanningSheet[]
  sharedAlbums    SharedAlbum[]
  pinnedRecords   PinnedRecord[]
  polls           GroupPoll[]
  decisionWheels  DecisionWheel[]
  anonymousPosts  AnonymousPost[]
  calendarEvents  CalendarEvent[]
  liveLocations   LiveLocationShare[]
  callSessions    CallSession[]
  momentVisibilities MomentVisibility[]

  @@index([handle])
  @@index([inviteCode])
}

model CircleMember {
  id        String     @id @default(cuid())
  circleId  String
  userId    String
  role      MemberRole @default(MEMBER)
  nickname  String?
  joinedAt  DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages         Message[]
  reactions        Reaction[]
  pollVotes        PollVote[]
  createdEvents    CalendarEvent[]
  createdSheets    PlanningSheet[]
  editedCells      SheetCell[]
  liveLocations    LiveLocationShare[]
  callParticipants CallParticipant[]
  createdInvites   CircleInvite[]

  @@unique([circleId, userId])
  @@index([circleId])
  @@index([userId])
}

model CircleInvite {
  id          String    @id @default(cuid())
  circleId    String
  code        String    @unique
  createdById String
  expiresAt   DateTime?
  maxUses     Int?
  useCount    Int       @default(0)
  createdAt   DateTime  @default(now())

  circle    Circle       @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdBy CircleMember @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([circleId])
  @@index([code])
}

model CircleJoinRequest {
  id        String            @id @default(cuid())
  circleId  String
  userId    String
  message   String?
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([circleId, status])
  @@index([userId])
}

// =============================================================================
// 3. MESSAGING & CHANNELS
// =============================================================================

model Channel {
  id        String      @id @default(cuid())
  circleId  String
  name      String
  type      ChannelType @default(TEXT)
  topic     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  circle   Circle    @relation(fields: [circleId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([circleId])
}

model Message {
  id            String      @id @default(cuid())
  channelId     String
  memberId      String
  type          MessageType @default(TEXT)
  content       String?
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  audioDuration Int?
  replyToId     String?
  sentAt        DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  channel      Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender       CircleMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  replyTo      Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]     @relation("MessageReplies")
  reactions    Reaction[]
  pinnedRecord PinnedRecord?

  @@index([channelId, sentAt(sort: Desc)])
  @@index([memberId])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  memberId  String
  emoji     String
  createdAt DateTime @default(now())

  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  CircleMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([memberId])
}

// =============================================================================
// 4. MOMENTS & SHARED ALBUMS
// =============================================================================

model Moment {
  id         String          @id @default(cuid())
  authorId   String
  photoUrl   String
  mediaType  MomentMediaType @default(IMAGE)
  caption    String?
  capturedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  author       User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  visibilities MomentVisibility[]
  reactions    MomentReaction[]

  @@index([authorId, createdAt(sort: Desc)])
}

model MomentVisibility {
  id        String   @id @default(cuid())
  momentId  String
  circleId  String
  createdAt DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@unique([momentId, circleId])
  @@index([circleId])
  @@index([momentId])
}

model MomentReaction {
  id        String   @id @default(cuid())
  momentId  String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId, emoji])
  @@index([momentId])
  @@index([userId])
}

model Photo {
  id            String   @id @default(cuid())
  sharedAlbumId String?
  fileUrl       String
  width         Int?
  height        Int?
  createdAt     DateTime @default(now())

  sharedAlbum SharedAlbum? @relation(fields: [sharedAlbumId], references: [id], onDelete: Cascade)

  @@index([sharedAlbumId])
}

model SharedAlbum {
  id         String   @id @default(cuid())
  circleId   String
  albumTitle String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  circle Circle  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@index([circleId])
}

// =============================================================================
// 5. COLLABORATIVE PLANNING SHEET (GRID MATRIX)
// =============================================================================

model PlanningSheet {
  id          String   @id @default(cuid())
  circleId    String
  createdById String
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  circle  Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  creator CircleMember  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  columns SheetColumn[]
  rows    SheetRow[]

  @@index([circleId])
}

model SheetColumn {
  id          String   @id @default(cuid())
  sheetId     String
  columnIndex Int
  columnTitle String
  createdAt   DateTime @default(now())

  sheet PlanningSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  cells SheetCell[]

  @@unique([sheetId, columnIndex])
}

model SheetRow {
  id        String   @id @default(cuid())
  sheetId   String
  rowIndex  Int
  createdAt DateTime @default(now())

  sheet PlanningSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  cells SheetCell[]

  @@unique([sheetId, rowIndex])
}

model SheetCell {
  id             String   @id @default(cuid())
  rowId          String
  columnId       String
  cellValue      String   @default("")
  lastEditedById String?
  updatedAt      DateTime @updatedAt

  row          SheetRow      @relation(fields: [rowId], references: [id], onDelete: Cascade)
  column       SheetColumn   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  lastEditedBy CircleMember? @relation(fields: [lastEditedById], references: [id], onDelete: SetNull)

  @@unique([rowId, columnId])
}

// =============================================================================
// 6. CIRCLE UTILITIES
// =============================================================================

model PinnedRecord {
  id        String   @id @default(cuid())
  circleId  String
  messageId String   @unique
  pinnedAt  DateTime @default(now())

  circle  Circle  @relation(fields: [circleId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([circleId])
}

model GroupPoll {
  id        String    @id @default(cuid())
  circleId  String
  question  String
  deadline  DateTime?
  isClosed  Boolean   @default(false)
  createdAt DateTime  @default(now())

  circle  Circle       @relation(fields: [circleId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]

  @@index([circleId])
}

model PollOption {
  id         String @id @default(cuid())
  pollId     String
  optionText String
  orderIndex Int    @default(0)

  poll  GroupPoll  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String   @id @default(cuid())
  pollId   String
  optionId String
  memberId String
  votedAt  DateTime @default(now())

  poll   GroupPoll    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)
  member CircleMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([pollId, memberId])
  @@index([pollId])
  @@index([memberId])
}

model DecisionWheel {
  id        String   @id @default(cuid())
  circleId  String
  title     String
  createdAt DateTime @default(now())

  circle  Circle        @relation(fields: [circleId], references: [id], onDelete: Cascade)
  options WheelOption[]

  @@index([circleId])
}

model WheelOption {
  id          String  @id @default(cuid())
  wheelId     String
  optionLabel String
  color       String?

  wheel DecisionWheel @relation(fields: [wheelId], references: [id], onDelete: Cascade)

  @@index([wheelId])
}

model AnonymousPost {
  id        String   @id @default(cuid())
  circleId  String
  content   String
  postedAt  DateTime @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)

  @@index([circleId, postedAt(sort: Desc)])
}

model CalendarEvent {
  id           String    @id @default(cuid())
  circleId     String
  createdById  String
  eventTitle   String
  description  String?
  startTime    DateTime
  endTime      DateTime?
  reminderTime DateTime?
  createdAt    DateTime  @default(now())

  circle  Circle       @relation(fields: [circleId], references: [id], onDelete: Cascade)
  creator CircleMember @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([circleId, startTime])
}

model LiveLocationShare {
  id            String   @id @default(cuid())
  circleId      String
  memberId      String
  latitude      Float
  longitude     Float
  shareDuration Int      // in minutes
  expiresAt     DateTime
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  circle Circle       @relation(fields: [circleId], references: [id], onDelete: Cascade)
  member CircleMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([circleId, isActive])
}

model CallSession {
  id        String     @id @default(cuid())
  circleId  String
  callType  CallType   @default(AUDIO)
  status    CallStatus @default(ACTIVE)
  startedAt DateTime   @default(now())
  endedAt   DateTime?

  circle       Circle            @relation(fields: [circleId], references: [id], onDelete: Cascade)
  participants CallParticipant[]

  @@index([circleId, status])
}

model CallParticipant {
  id            String    @id @default(cuid())
  callSessionId String
  memberId      String
  joinedAt      DateTime  @default(now())
  leftAt        DateTime?

  callSession CallSession  @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  member      CircleMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([callSessionId])
  @@index([memberId])
}
