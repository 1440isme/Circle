# =============================================================================
# CIRCLE ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (PostgreSQL / Neon)
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="circle_dev"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://user:password@localhost:5432/circle_dev?schema=public"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/circle_dev?schema=public"

# Redis (Upstash or Local)
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Authentication (JWT)
JWT_ACCESS_SECRET="replace-with-a-very-long-random-secret-key-32-chars-min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-another-very-long-secret-key-32-chars-min"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudflare R2 Storage (S3-Compatible)
CLOUDFLARE_R2_ACCOUNT_ID="your-r2-account-id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-r2-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="circle-media-dev"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://media.circle.example.com"

# WebRTC STUN/TURN Servers
STUN_SERVER_URL="stun:stun.l.google.com:19302"
TURN_SERVER_URL="turn:turn.circle.example.com:3478"
TURN_USERNAME="circle-user"
TURN_CREDENTIAL="circle-turn-secret"

# Email Delivery (SMTP)
# Options: Gmail SMTP (smtp.gmail.com:587 with App Password), Resend (smtp.resend.com:465), Mailtrap, SendGrid
# Note: If left unset, Circle runs local Stream Mailer and logs full email content + OTP directly to backend terminal.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CIRCLE <no-reply@circle.local>"
